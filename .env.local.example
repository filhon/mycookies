# Copie para .env.local e preencha com os dados do projeto no console do Firebase
# (Configurações do projeto → Seus apps → Configuração do SDK).
#
# Estas chaves são públicas por natureza: elas identificam o projeto, não
# autorizam nada. Quem protege os dados são as regras em firestore.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
# Aqui, no desenvolvimento local, o {id-do-projeto}.firebaseapp.com do console.
# Em produção (Vercel), o domínio do app, sem https://: o login do Google volta
# por /__/auth/* no próprio domínio, pelo rewrites de next.config.ts (spec 043,
# DECISOES.md#d199, docs/DEPLOY.md § 11).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Caminho para a chave de conta de serviço. Usada pelo script que cria a conta e
# concede o acesso, e pela rota /api/nota, que confere o token de quem chama.
# NUNCA versionar esse arquivo.
#
# Isto é um CAMINHO de arquivo, e por isso vale só aqui, onde existe disco.
# Na hospedagem use FIREBASE_SERVICE_ACCOUNT, logo abaixo.
GOOGLE_APPLICATION_CREDENTIALS=./chave-servico.json

# ---------------------------------------------------------------------------
# Só na hospedagem (Vercel). Deixe VAZIO no .env.local.
#
# O conteúdo do mesmo JSON da chave de conta de serviço, em uma linha — ou o
# mesmo JSON em base64, se o campo do painel comer as quebras de linha:
#
#   node -e "console.log(Buffer.from(require('fs').readFileSync('./chave-servico.json')).toString('base64'))"
#
# Esta chave IGNORA as regras do Firestore. Ela entra sem o prefixo
# NEXT_PUBLIC_, como a do Gemini, e só é lida por src/lib/server/.
# Ver docs/DEPLOY.md.
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Leitura de nota fiscal (spec 006)
#
# ATENÇÃO: esta NÃO é como as chaves acima. As do Firebase são públicas por
# natureza — identificam o projeto e não autorizam nada. Esta AUTORIZA GASTO.
#
# Por isso ela entra SEM o prefixo NEXT_PUBLIC_: tudo que carrega esse prefixo
# vai para dentro do bundle, que é servido para qualquer navegador. O único
# código que lê esta variável é src/app/api/nota/route.ts, que roda no
# servidor e não é importado por componente nenhum.
#
# Onde emitir: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# O modelo da leitura. Fica em variável para poder trocar sem deploy de código:
# a família anda rápido, e trocar de modelo é a resposta certa se a leitura
# piorar. Vazio usa gemini-3.5-flash-lite, o mais barato que aceita imagem e
# PDF na entrada e tem faixa gratuita.
GEMINI_MODELO=

# ---------------------------------------------------------------------------
# A assinatura (spec 028), em modo de teste no painel do Stripe.
#
# ATENÇÃO: assim como a do Gemini, esta NÃO é como as chaves do Firebase.
# Esta AUTORIZA COBRAR de outras pessoas — e o webhook, com o segredo errado
# ou ausente, é quem escreve `acessoAte` na claim de qualquer login. Nenhuma
# delas leva NEXT_PUBLIC_, e só src/lib/server/ e src/app/api/ as leem.
#
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# https://dashboard.stripe.com/test/webhooks — ou, no `npm run dev`, o que o
# Stripe CLI imprime: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Os dois preços recorrentes do produto "Rende", o plano essencial
# (docs/DEPLOY.md tem o passo a passo de criar o produto e os preços no painel).
STRIPE_PRICE_MENSAL=
STRIPE_PRICE_ANUAL=

# Os dois preços do produto "Rende Completo" (spec 032), o que tem
# `metadata.pacote = COMPLETO`. Sem os quatro, /assinatura diz que a assinatura
# não está configurada.
STRIPE_PRICE_COMPLETO_MENSAL=
STRIPE_PRICE_COMPLETO_ANUAL=
