rules_version = '2';

// Rende — acesso estritamente privado.
// Regra de ouro: NADA fora de contas/{contaId}. O dono do dado é o negócio,
// não o login: quem entrou traz na claim o mapa das contas que pode abrir.
service cloud.firestore {
  match /databases/{database}/documents {

    // Negação padrão para qualquer caminho não previsto abaixo.
    match /{document=**} {
      allow read, write: if false;
    }

    match /contas/{contaId} {
      // A claim `contas` é um mapa { contaId: papel }, emitida via Admin SDK
      // por /api/conta, /api/conta/membros, pelo webhook do Stripe e pelo script
      // scripts/conceder-acesso.mjs. Checar claim custa ZERO leitura — um
      // allowlist em documento (`get(/membros/$(uid))`) seria cobrado a cada
      // avaliação de regra, inclusive nas negadas.
      function temAcesso() {
        return request.auth != null
            && 'contas' in request.auth.token
            && request.auth.token.contas[contaId] != null;
      }

      // Escrever tem prazo; ler não. `acessoAte` traz, por conta, até quando (ms de
      // época) esta conta pode escrever — escrito por /api/conta (o teste), pelo
      // convite da ajudante e pelo webhook do Stripe (a assinatura). Sem a chave,
      // não há prazo: é a conta liberada à mão (DECISOES.md#d141, #d144). Zero
      // leitura, como #d07: o relógio é request.time.
      function podeEscrever() {
        return temAcesso()
            && !('acessoAte' in request.auth.token
                 && contaId in request.auth.token.acessoAte
                 && request.time.toMillis() > request.auth.token.acessoAte[contaId]);
      }

      // Dois papéis: 'DONA' e 'AJUDANTE' (DECISOES.md#d153). Só 'DONA' é dona;
      // qualquer outro valor cai no lado restrito — errar para menos acesso.
      function ehDona() {
        return temAcesso() && request.auth.token.contas[contaId] == 'DONA';
      }

      // O dinheiro não é da ajudante: ela não lê nem escreve estas três.
      function doDinheiro(colecao) {
        return colecao in ['transacoes', 'metas', 'agregados'];
      }

      // Espelho dos acessos: a claim é a verdade, e quem escreve é o Admin SDK
      // (DECISOES.md#d155). Nem a dona escreve daqui.
      function soDoServidor(colecao) {
        return colecao == 'membros';
      }

      allow read: if temAcesso();
      allow write: if podeEscrever() && ehDona(); // o documento da conta é da dona

      // IMPORTANTE: a restrição mora DENTRO desta regra, e não numa regra ao
      // lado. No Firestore, regras que casam com o mesmo caminho se somam por
      // OU: um `match /configuracao/{doc}` negando ao lado deste não negaria
      // nada (DECISOES.md#d154). Por isso o nome da coleção é capturado aqui.
      match /{colecao}/{documento=**} {
        allow read: if temAcesso() && (ehDona() || !doDinheiro(colecao));
        allow write: if podeEscrever()
                     && !soDoServidor(colecao)
                     && (ehDona()
                         || !(doDinheiro(colecao) || colecao == 'configuracao'));
      }
    }
  }
}
